generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model User {
  id        String   @id @default(cuid())
  githubId  String   @unique
  username  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
}

model Job {
  id         String     @id @default(cuid())
  repoUrl    String
  status     JobStatus  @default(QUEUED)
  visibility Visibility @default(PUBLIC)
  result     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // null = anonymous analysis; SetNull keeps the job if the user is deleted
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([visibility, status, createdAt]) // explore feed
}
