# Neon Postgres
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/repoanalyzer?sslmode=require"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000

# Optional — raises GitHub API limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Groq — AI metrics (architecture summary, contribution suggestions)
GROQ_API_KEY=

# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Auth
JWT_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:3001
